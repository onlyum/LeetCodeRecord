{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ensure cpp-out",
            "type": "shell",
            "command": "New-Item -ItemType Directory -Force -Path \"${workspaceFolder}\\.cpp-out\" | Out-Null",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "build cpp file",
            "dependsOn": "ensure cpp-out",
            "dependsOrder": "sequence",
            "type": "process",
            "command": "D:\\envs\\mingw64\\bin\\g++.exe",
            "args": [
                "-g",
                "-static",
                "-static-libgcc",
                "-static-libstdc++",
                "-finput-charset=UTF-8",
                "-fexec-charset=GBK",
                "${file}",
                "-o",
                "${workspaceFolder}\\.cpp-out\\run.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
